              <calculation class='tableau' formula='{ FIXED [visit_id] : MAX(&#10;    IF [process_step] = &apos;start&apos; THEN 1&#10;    ELSEIF [process_step] = &apos;step_1&apos; THEN 2&#10;    ELSEIF [process_step] = &apos;step_2&apos; THEN 3&#10;    ELSEIF [process_step] = &apos;step_3&apos; THEN 4&#10;    ELSEIF [process_step] = &apos;confirm&apos; THEN 5&#10;    END&#10;) }' />

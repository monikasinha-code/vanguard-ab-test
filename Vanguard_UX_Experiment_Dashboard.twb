      <aliases enabled='yes' />
      <column caption='Time Spent Calculation' datatype='integer' name='[Calculation_6318424437149697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [visit_id], [process_step] : DATEDIFF(&apos;second&apos;, MIN([date_time]), MAX([date_time])) }' />
      </column>
      <column caption='Stage of Abandonment' datatype='integer' name='[Calculation_6318424438648834]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [visit_id] : MAX(&#10;    IF [process_step] = &apos;start&apos; THEN 1&#10;    ELSEIF [process_step] = &apos;step_1&apos; THEN 2&#10;    ELSEIF [process_step] = &apos;step_2&apos; THEN 3&#10;    ELSEIF [process_step] = &apos;step_3&apos; THEN 4&#10;    ELSEIF [process_step] = &apos;confirm&apos; THEN 5&#10;    END&#10;) }' />
        <aliases>
          <alias key='1' value='start' />
          <alias key='2' value='step_1' />
          <alias key='3' value='step_2' />
          <alias key='4' value='step_3' />
          <alias key='5' value='confirm' />
        </aliases>
      </column>
      <column caption='reached_confirm' datatype='boolean' name='[Calculation_6318424439984131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [visit_id] : MAX(IF [process_step] = &apos;confirm&apos; THEN TRUE ELSE FALSE END) }' />
      </column>
      <column caption='Unique Visits' datatype='integer' name='[Calculation_6318424443326468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([visit_id])' />
      </column>
      <column caption='Total Unique Users' datatype='integer' name='[Calculation_6318424561139718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Variation] : COUNTD([client_id]) }' />
      </column>
      <column caption='Overall Completion Rate' datatype='real' name='[Calculation_6318424561426439]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [process_step] = &apos;confirm&apos; THEN [client_id] END) / SUM([Calculation_6318424561139718])' />
      </column>
      <column caption='True High-Balance Completion Rate' datatype='real' default-format='p0.00%' name='[Calculation_6318424592871442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_high_balance] = TRUE AND [Calculation_6318424439984131] = TRUE THEN [client_id] END)&#10;/&#10;COUNTD(IF [is_high_balance] = TRUE THEN [client_id] END)' />
      </column>
      <column caption='VIP Success Rate' datatype='real' name='[Calculation_6318425951277075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [process_step] = &apos;confirm&apos; THEN [client_id] END) / COUNTD([client_id])' />
      </column>
      <column datatype='string' name='[Variation]' role='dimension' type='nominal' />

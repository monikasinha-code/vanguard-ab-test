        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97800' id='16' param='vert' type-v2='layout-flow' w='98752' x='624' y='1100'>
            <zone h='97800' id='11' param='horz' type-v2='layout-flow' w='98752' x='624' y='1100'>
              <zone h='97800' id='7' param='horz' type-v2='layout-flow' w='59157' x='624' y='1100'>
                <zone h='97800' id='5' type-v2='layout-basic' w='28058' x='624' y='1100'>
                  <zone h='97800' id='3' name='Sheet 11' w='28058' x='624' y='1100'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
                <zone fixed-size='399' h='97800' id='6' is-fixed='true' param='vert' type-v2='layout-flow' w='31099' x='28682' y='1100'>
                  <zone h='97800' id='9' name='Sheet 12' w='31099' x='28682' y='1100'>
                    <layout-cache cell-count-w='2' minheight='184' non-cell-size-w='86' type-h='scalable' type-w='cell' />
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone fixed-size='508' h='97800' id='10' is-fixed='true' param='vert' type-v2='layout-flow' w='39595' x='59781' y='1100'>
                <zone fixed-size='671' forceUpdate='true' h='93397' id='12' is-fixed='true' type-v2='text' w='39595' x='59781' y='1100'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans,sans-serif' fontsize='14'>The Core Business Hurdle</run>
                    <run>Æ&#10;&#10;</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Vanguard required an absolute </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>5.00% minimum lift</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> in completion rates to justify the engineering and rollout costs of the new UI. </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>The new design failed this hurdle across all segments.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans,sans-serif' fontsize='14'>1. Overall Population Performance</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Control Baseline:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> 66.76%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Test Achieved:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> 70.47%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Absolute Lift:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>+3.71%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Target Hurdle:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>71.76%</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12' italic='true'>(Control + 5.00%)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Status:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> ❌ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>FAILED</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> (Missed target by 1.29%)</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans,sans-serif' fontsize='14'>2. High-Balance Segment Performance</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Control Baseline:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> 66.78%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Test Achieved:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> 70.54%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Absolute Lift:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>+3.76%</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Target Hurdle:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>71.78%</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Æ </run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12' italic='true'>(Segment Baseline + 5.00%)</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>Status:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> ❌ </run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'>FAILED</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12'> (Missed target by 1.24%)</run>
                    <run>Æ&#10;</run>
                    <run lmargin='600' rmargin='600'>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='14' lmargin='600' rmargin='600'>Strategic Insight:</run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='11' lmargin='600' rmargin='600'>Æ </run>
                    <run fontcolor='#000000' fontname='Google Sans Text,sans-serif' fontsize='12' lmargin='600' rmargin='600'>While high-balance clients finished at a higher absolute floor (70.54%), their net lift (3.76%) is statistically identical to the general population. The conversion friction is systemic, not demographic.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />

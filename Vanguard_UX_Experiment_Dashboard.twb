  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='Core Performance &amp; Business Hurdle'>
      <style>
        <style-rule element='dash-title'>
          <format attr='font-weight' value='bold' />
          <format attr='text-align' value='center' />
          <format attr='color' value='#da372d' />
